{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newyorkhut",
  "main": "src/index.js",
  "compatibility_date": "2026-07-20",
  "workers_dev": true,
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "DEPLOY_RELEASE": "v80-explicit-static-asset-banner-2026-08-02-01"
  },
  "observability": {
    "enabled": true
  }
}
