{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newyorkhut",
  "main": "src/index.js",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "DEPLOY_RELEASE": "v118-core-guides-consolidation-2026-10-06"
  },
  "observability": {
    "enabled": true
  }
}
